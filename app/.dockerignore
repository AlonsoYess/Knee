# Closed application-only context. Keep in sync with deploy/build_context.py.
**
!Dockerfile
!.dockerignore
!backend/
!backend/requirements.lock
!backend/knee_app/
!backend/knee_app/*.py
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**/
!frontend/src/**/*.ts
!frontend/src/**/*.vue
!frontend/src/**/*.css
!frontend/public/
!frontend/public/manifest.webmanifest
!frontend/public/icons/
!frontend/public/icons/kneeoai.svg
!frontend/public/icons/kneeoai-maskable.svg
!frontend/public/icons/kneeoai-192.png
!frontend/public/icons/kneeoai-512.png
!frontend/scripts/
!frontend/scripts/pwa-build.mjs
!frontend/scripts/pwa-build.d.mts
!frontend/scripts/pwa-worker.js
# Defense in depth inside the permitted source directories.
**/runtime/**
**/node_modules/**
**/.venv*/**
**/__pycache__/**
**/.git/**
**/secrets/**
**/private/**
**/data/**
**/datasets/**
**/models/**
**/weights/**
**/notebooks/**
**/.env*
**/*.key
**/*.pem
**/*.sqlite3*
**/*.db*
**/*.dcm
**/*.dicom
**/*.npy
**/*.npz
**/*.pt
**/*.pth
**/*.ckpt
**/*.onnx
**/*.safetensors
**/*.ipynb
