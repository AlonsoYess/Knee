{
  "name": "kneeoai-prototype-ui",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test:contracts": "node scripts/validate-contract.mjs",
    "test:e2e": "playwright test",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:pwa:unit": "node scripts/test-pwa.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.70.0",
    "vue": "3.5.45",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-vue": "6.0.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.3.14"
  }
}
