# Configuration guide, not a live deployment. Choose one origin after provider approval.
# Never put operational secrets, passwords, patient identifiers or data in this file.
KNEEOAI_ENV=production
KNEEOAI_DATA_DIR=/var/lib/kneeoai
KNEEOAI_FRONTEND_DIST=/opt/kneeoai/frontend
KNEEOAI_ALLOWED_ORIGINS=https://your-service.example.invalid
KNEEOAI_SECRET_KEY_FILE=/run/secrets/session_key
KNEEOAI_FORWARDED_ALLOW_IPS=
PORT=8080
# WEB_CONCURRENCY must remain 1. The deploy entry point starts exactly one worker.
# The secret file contains a freshly generated 64-character ASCII hexadecimal value.
# Use the provider's secret configuration or a secret file, never a build argument.
# This image intentionally contains no scientific checkout, models, data or default accounts.
