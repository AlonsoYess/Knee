{
    admin off
    auto_https off
}

https://localhost:8443, https://127.0.0.1:8443 {
    tls /run/secrets/tls_cert /run/secrets/tls_key
    request_body {
        max_size 67108864
    }
    reverse_proxy app:8080 {
        transport http {
            response_header_timeout 150s
            read_timeout 180s
            write_timeout 180s
        }
    }
}
